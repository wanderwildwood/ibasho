<?xml version="1.0" encoding="utf-8"?>

<!-- https://developer.android.com/privacy-and-security/security-config -->
<!-- WARNING: This is the main config! For dev builds, see the dev config!-->

<network-security-config>
    <!-- People can self-host FMD Server, therefore the config needs to be general. -->
    <!-- Since FMD Server uses the WebCrypto API, people MUST use TLS anyway, -->
    <!-- thus we can disallow cleartext traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />

            <!-- Many people use private CAs-->
            <certificates src="user" />
        </trust-anchors>

        <!-- Private CAs may not write to CT logs -->
        <certificateTransparency enabled="false" />
    </base-config>

</network-security-config>
