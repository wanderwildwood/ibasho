<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- force-lock only. wipe-data is deliberately absent: Android enforces the
         policies declared here, so the app is incapable of wiping the device even
         if code asked it to. Removing DeleteCommand alone would not give that. -->
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>