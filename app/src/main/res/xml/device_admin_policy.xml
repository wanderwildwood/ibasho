<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- force-lock for the lock command, and nothing else. There is no wipe command, and
         without wipe-data declared here Android would not let the app erase the phone even if
         some code asked it to. -->
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
